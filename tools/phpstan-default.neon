parameters:
	# The strictest level. It is the default so a new package starts fully
	# checked instead of quietly at level 8. A package that needs a lower level
	# says so in its own config, next to the code that needs it.
	level: 10
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# tests assert against known static types intentionally
		- identifier: staticMethod.alreadyNarrowedType
